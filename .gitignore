# =============================================================================
# LearnIsphere Root .gitignore (Frontend, Dashboard & Django Backend)
# =============================================================================

# --- Environment & Secrets (Keep *.example tracked) ---
.env
.env.*
*.env
!.env.example
!env.example

# --- Certificates, Keys & Credentials ---
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# --- Node.js / Frontend / Next.js / Vite ---
node_modules/
.pnp
.pnp.js
.next/
out/
dist/
build/
.cache/
.vite/
.turbo/
vite.config.*.timestamp-*
*.tsbuildinfo
next-env.d.ts.bak

# --- Python / Django Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# --- Databases & Local Storage ---
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
db.sqlite3
dump.rdb

# --- Django Collected Static & User Uploaded Media ---
staticfiles/
media/
Dashboard/Learnishpere backend Django/media/

# --- Logs & Temp Files ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*-debug.log*
.tmp-*
temp/
tmp/

# --- Editor, OS & Agent State ---
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.claude-replay.*
.figma/design-context/
.plugins/
.opencode-skills/

